# Vite emits hashed JS/CSS filenames to /assets/ (e.g. index-ABC123.js).
# When a file's contents change, Vite changes its URL, making long browser
# caching safe. Do not cache HTML, sitemap, robots, images, or API routes here.
#
# The Cloudflare Pages _headers format applies only to static asset responses.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
