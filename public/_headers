# Apply conservative browser security protections to Cloudflare Pages static responses.
# CSP limits who may frame OUR website, not the Calendly/Jotform iframes
# displayed inside it. Avoid restrictive script-src, frame-src or microphone
# policies until third-party integrations have been separately audited.
# Pages Functions responses do not inherit this file's security headers.
/*
  Strict-Transport-Security: max-age=15552000
  X-Frame-Options: SAMEORIGIN
  Content-Security-Policy: frame-ancestors 'self'; base-uri 'self'; object-src 'none'
  Permissions-Policy: geolocation=(), usb=()

# Keep long-term caching limited to Vite's fingerprinted assets.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
